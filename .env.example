# Neon PostgreSQL - server only. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Production uses this dedicated Neon URL to avoid provider integration overrides.
TAQYEEM_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js / NextAuth secret. Generate a long random value (32+ bytes).
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Neon Object Storage (S3-compatible), server only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_DESIGN_BUCKET=design-assets
NEON_RECRUITMENT_BUCKET=recruitment-cv

# Optional transactional email via Resend (password reset, recruitment confirmations). Leave empty to disable sending.
RESEND_API_KEY=
EMAIL_FROM=


NEXT_PUBLIC_APP_NAME=نظام تقييم أداء الموظفين

# Optional CLI helper for npm run create:super-admin.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=StrongPasswordHere
SUPER_ADMIN_NAME=مدير النظام
